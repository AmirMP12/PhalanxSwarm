# Copy to .env (never commit .env). Use `pnpm judge:offline` for fully local testing.
#
# Vercel: Set variables in Project Settings > Environment Variables (this file is not read there).
# NEXT_PUBLIC_* values are inlined at build time, so redeploy after changing them.

# ================================================================
# WEB APP - Required for demo site
# ================================================================

# NEAR network configuration
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Read-only RPC URL (leave empty to use FastNEAR with near.org fallback)
NEXT_PUBLIC_NEAR_RPC_URL=

# Deployed contract (defaults to aegis-69b4.phalanxswarm.testnet if unset)
NEXT_PUBLIC_AEGIS_CONTRACT_ID=aegis-69b4.phalanxswarm.testnet

# ================================================================
# AI & VERIFICATION - Optional (uses fallbacks when unset)
# ================================================================

# NEAR AI Cloud API key for TEE attestation (optional, server-side only)
# Get from: https://app.near.ai/
# Without this, uses deterministic local verification mode
NEARAI_API_KEY=

# TEE verification mode: auto | live | offline
# - auto: Try live TEE, fall back to cached/offline (recommended)
# - live: Require live TEE (fails if unavailable)
# - offline: Use deterministic local mode only
AEGIS_TEE_MODE=auto
AEGIS_TEE_TIMEOUT_MS=10000

# ================================================================
# NEAR INTENTS - Optional (for 1Click quotes)
# ================================================================

# 1Click API endpoint (uses dry-run mode per hackathon Rule Q-007)
ONECLICK_API_BASE=https://1click.chaindefuser.com

# Optional partner JWT from https://partners.near-intents.org (Rule Q-006)
# Without this, 1Click applies unauthenticated fees
ONECLICK_JWT=

# Intents mode: auto | live | offline
AEGIS_INTENTS_MODE=auto
AEGIS_INTENTS_TIMEOUT_MS=6000

# ================================================================
# DEPLOYMENT SCRIPTS - Only needed for contract deployment
# ================================================================

# Path to NEAR testnet credentials JSON
# Example: ~/.near-credentials/testnet/your-account.testnet.json
AEGIS_TESTNET_CREDENTIAL=

# Deployed contract account (set after deployment)
AEGIS_CONTRACT_ACCOUNT=aegis-69b4.phalanxswarm.testnet

# DAO owner account (set after deployment)
AEGIS_OWNER_ACCOUNT=aegis-69b4.sputnikv2.testnet

# NEAR protocol contracts (standard testnet contracts)
AEGIS_MPC_CONTRACT=v1.signer-prod.testnet
AEGIS_INTENTS_CONTRACT=intents.near

# ================================================================
# TESTNET SWARM DEPLOYMENT - Only for `pnpm testnet:swarm`
# ================================================================

# Unique suffix for your deployment (e.g., 69b4, abc123)
AEGIS_SWARM_SUFFIX=

# DAO creation deposit in NEAR (minimum 6)
AEGIS_DAO_DEPOSIT_NEAR=6

# EVM chain for cross-chain transfers: basesepolia | sepolia
AEGIS_EVM_CHAIN=basesepolia

# Optional: EVM address for vendor payments
AEGIS_VENDOR_EVM=

# Optional: NEAR mainnet credential for oneclick:fund
AEGIS_MAINNET_CREDENTIAL=
