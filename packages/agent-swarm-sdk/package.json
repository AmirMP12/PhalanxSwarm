{
  "name": "@aegis/agent-swarm-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "AegisSwarm multi-agent runtime: in-process NEAR VM for aegis_core.wasm, NEAR Intents 1Click client, TEE receipt prover, Chain Signatures tooling and the 4-agent swarm orchestrator",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "judge": "tsx src/cli.ts",
    "eval:injection": "tsx src/eval-cli.ts",
    "market": "tsx src/market-cli.ts",
    "mcp": "tsx src/mcp-cli.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@phala/dcap-qvl": "^0.7.0",
    "@scure/base": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
