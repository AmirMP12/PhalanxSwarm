{
  "name": "aegis-swarm",
  "version": "0.1.0",
  "private": true,
  "description": "PhalanxSwarm Protocol: policy-enforced autonomous agent treasury, swarm bidding market and NEAR Intents / Chain Signatures settlement on NEAR",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:shell",
    "lint:code": "eslint . --max-warnings 0",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:fix": "eslint . --fix",
    "check:source": "node scripts/check-source-integrity.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "audit:js": "pnpm audit --audit-level low",
    "audit:rust": "bash -lc 'cargo audit'",
    "audit": "pnpm audit:js && pnpm audit:rust",
    "build:contract": "bash scripts/build-contract.sh",
    "build:contract:reproducible": "bash scripts/build-reproducible.sh",
    "verify:reproducible": "bash scripts/build-reproducible.sh --verify",
    "test:contract": "bash -lc 'cargo test -p aegis-core --locked'",
    "test:sandbox": "bash scripts/sandbox-docker.sh",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "judge": "pnpm --filter @aegis/agent-swarm-sdk judge",
    "judge:offline": "pnpm --filter @aegis/agent-swarm-sdk judge --offline",
    "judge:attack": "pnpm --filter @aegis/agent-swarm-sdk judge --offline --attack",
    "eval:injection": "pnpm --filter @aegis/agent-swarm-sdk eval:injection",
    "market": "pnpm --filter @aegis/agent-swarm-sdk market",
    "mcp": "pnpm --silent --filter @aegis/agent-swarm-sdk mcp",
    "dev": "pnpm --filter @aegis/web dev",
    "verify": "bash scripts/verify-all.sh",
    "testnet:smoke": "tsx scripts/testnet-smoke.ts",
    "testnet:wallet": "node scripts/wallet-smoke.mjs",
    "testnet:swarm": "tsx scripts/testnet-swarm.ts",
    "evm:relay": "tsx scripts/evm-relay.ts",
    "oneclick:fund": "tsx scripts/oneclick-fund.ts",
    "verify:tee": "tsx scripts/nearai-smoke.ts",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "pnpm": {
    "overrides": {
      "postcss@<=8.5.17": "8.5.32"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "15.5.28",
    "@types/node": "^20.19.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "near-api-js": "^7.4.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
